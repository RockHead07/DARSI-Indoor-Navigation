<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UIToolkit/LoginScreen.uss?fileID=7433441132597879392&amp;guid=eab169b6aafda754680d56c11ecb3f16&amp;type=3#LoginScreen"/>
    <ui:VisualElement name="root" class="login-root">
        <ui:VisualElement name="topbar" class="topbar">
            <ui:Button name="btn-back" class="back-btn"/>
            <ui:Label name="topbar-title" text="Masuk" class="topbar-title"/>
        </ui:VisualElement>
        <ui:VisualElement name="hero" class="hero">
            <ui:VisualElement class="hero-icon" style="background-image: url(&quot;project://database/Assets/PENS.png?fileID=21300000&amp;guid=9e32067202be73a4eb9165fc7b9f65ea&amp;type=3#PENS&quot;); background-color: rgb(255, 255, 255);"/>
            <ui:VisualElement class="hero-texts">
                <ui:Label name="hero-title" text="Selamat datang kembali" class="hero-title"/>
                <ui:Label name="hero-sub" text="Masuk untuk melanjutkan navigasi" class="hero-sub"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="form" class="form">
            <ui:VisualElement name="error-banner" class="error-banner">
                <ui:Label text="ⓧ" class="error-icon"/>
                <ui:Label name="error-text" text="Email atau password salah. Periksa kembali dan coba lagi." class="error-banner-text"/>
            </ui:VisualElement>
            <ui:VisualElement class="field-group">
                <ui:Label text="Email" class="field-label"/>
                <ui:VisualElement name="email-box" class="field-box">
                    <ui:VisualElement class="field-icon icon-mail"/>
                    <ui:TextField name="email-input" class="field-input"/>
                    <ui:VisualElement name="email-check" class="check-icon"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="field-group">
                <ui:Label text="Password" class="field-label"/>
                <ui:VisualElement name="pass-box" class="field-box">
                    <ui:VisualElement class="field-icon icon-lock"/>
                    <ui:TextField name="pass-input" password="true" class="field-input"/>
                    <ui:Button name="btn-eye" class="field-trail icon-eye"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="btn-forgot" text="Lupa password?" class="forgot-link"/>
            <ui:Button name="btn-submit" text="Masuk" class="btn-submit"/>
            <ui:Label name="loading-progress" text="Mengambil data role · Menyiapkan peta · Menginisialisasi AR…" class="loading-progress"/>
            <ui:VisualElement class="info-box">
                <ui:VisualElement class="info-icon info-icon-shield"/>
                <ui:VisualElement class="info-texts">
                    <ui:Label text="Role otomatis dari sistem" class="info-title"/>
                    <ui:Label text="Role kamu (Mahasiswa/Dosen/Staff) sudah ditentukan admin. Tidak perlu memilih." class="info-desc"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="spacer"/>
            <ui:VisualElement class="footer" style="height: 95px;">
                <ui:Label text="Belum punya akun?" class="footer-text" style="height: 49px;"/>
                <ui:Button name="btn-register" text="Daftar sekarang" class="footer-link" style="height: 52px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
