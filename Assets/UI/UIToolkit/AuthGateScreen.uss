/* ══════════════════════════════════════════════
   Auth Gate Screen — MultiSetNav
   Reference: 1080 × 1920
   ══════════════════════════════════════════════ */

/* ─── Root ─── */
.authgate-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(210, 232, 255);
}

/* ─── Hero ─── */
.hero {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    padding-bottom: 32px;
}

.app-icon {
    width: 88px;
    height: 88px;
    border-radius: 22px;
    background-color: rgb(26, 58, 143);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.app-icon-img {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI/Images/Voice-Logo.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.app-name {
    font-size: 16px;
    color: rgb(26, 58, 143);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.headline {
    font-size: 34px;
    color: rgb(15, 23, 60);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 16px;
    color: rgb(107, 114, 128);
    -unity-text-align: middle-center;
}

/* ─── Bottom Sheet ─── */
.bottom-sheet {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 32px;
    padding-bottom: 12px;
    flex-direction: column;
}

/* ─── Primary Button (Masuk) ─── */
.btn-primary {
    background-color: rgb(26, 58, 143);
    border-width: 0;
    border-radius: 50px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 20px;
    padding-bottom: 20px;
    margin-bottom: 14px;
}

.btn-primary:hover {
    background-color: rgb(20, 46, 115);
    border-width: 0;
}

/* ─── Secondary Button (Daftar) ─── */
.btn-secondary {
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(26, 58, 143);
    border-radius: 50px;
    color: rgb(26, 58, 143);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 20px;
    padding-bottom: 20px;
    margin-bottom: 24px;
}

.btn-secondary:hover {
    background-color: rgb(235, 241, 255);
    border-width: 2px;
    border-color: rgb(26, 58, 143);
}

/* ─── Divider ─── */
.divider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgb(220, 224, 230);
    margin-left: 12px;
    margin-right: 12px;
}

.divider-text {
    font-size: 14px;
    color: rgb(150, 160, 175);
    -unity-text-align: middle-center;
}

/* ─── Guest Button ─── */
.btn-guest {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: rgb(26, 58, 143);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-decoration: underline;
    margin-bottom: 20px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.btn-guest:hover {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: rgb(15, 38, 100);
}

/* ─── Info Box ─── */
.info-box {
    flex-direction: row;
    align-items: flex-start;
    background-color: rgb(242, 244, 247);
    border-radius: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 16px;
}

.info-icon {
    font-size: 18px;
    color: rgb(26, 58, 143);
    margin-right: 10px;
    -unity-text-align: upper-left;
    flex-shrink: 0;
}

.info-text {
    font-size: 14px;
    color: rgb(26, 58, 143);
    white-space: normal;
    flex-grow: 1;
}

/* ─── Spacer ─── */
.spacer {
    flex-grow: 1;
}

/* ─── Footer ─── */
.footer-text {
    font-size: 12px;
    color: rgb(180, 185, 195);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 10px;
}

/* ─── Button Icon ─── */
.btn-with-icon {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.btn-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 16px;
    flex-shrink: 0;
}

.icon-enter {
    background-image: url("project://database/Assets/Icon/icon-enter.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.icon-user-add {
    background-image: url("project://database/Assets/Icon/icon-user-add.png");
    -unity-background-image-tint-color: rgb(26, 58, 143);
}

.btn-text {
    -unity-font-style: bold;
}

.btn-text-primary   { color: rgb(255, 255, 255); }
.btn-text-secondary { color: rgb(26, 58, 143); }

/* ─── Home Indicator ─── */
.home-indicator {
    width: 140px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(200, 205, 215);
    align-self: center;
    margin-top: 4px;
}
