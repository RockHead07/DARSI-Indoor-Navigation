/* ══════════════════════════════════════════════
   Splash Screen — MultiSetNav
   Reference: 1080 × 1920 (ScaleWithScreenSize)
   All sizing lives HERE — keep UXML free of inline styles.
   ══════════════════════════════════════════════ */

/* ─── Root ─── */
.splash-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(210, 232, 255);
}

/* ─── Hero Area (~62%) ─── */
.hero-area {
    flex-grow: 1;
    min-height: 62%;
    position: relative;
}

/* ─── Center PENS Logo (raised, ~20% smaller) ─── */
.center-logo {
    position: absolute;
    top: 12%;
    left: 22%;
    right: 22%;
    bottom: 26%;
    align-items: center;
    justify-content: center;
}

.pens-logo {
    width: 190px;
    height: 190px;
    background-image: url("project://database/Assets/PENS.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

/* ─── Floating Icon Cards — base ─── */
.icon-card {
    position: absolute;
    align-items: center;
    justify-content: center;
}

.card-medium { width: 90px; height: 90px; border-radius: 26px; }
.card-small  { width: 70px; height: 70px; border-radius: 20px; }

.card-navy      { background-color: rgb(26, 58, 143); }
.card-white     { background-color: rgb(255, 255, 255); }
.card-yellow    { background-color: rgb(255, 185, 0); }
.card-lightblue { background-color: rgb(59, 153, 252); }

/* spread across hero, incl. center-top near logo */
.card-nav     { top: 9%;  left: 36%; }
.card-edu     { top: 7%;  left: 9%;  }
.card-device  { top: 5%;  right: 11%; }
.card-compass { top: 15%; right: 6%; }
.card-map     { top: 30%; left: 4%;  }
.card-star    { top: 38%; right: 9%; }
.card-wave    { top: 56%; left: 8%;  }
.card-send    { top: 60%; left: 37%; }

/* ─── Icon images inside cards ─── */
.icon-img {
    width: 55%;
    height: 55%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.icon-nav     { background-image: url("project://database/Assets/Icon/weui--back-filled.png"); }
.icon-edu     { background-image: url("project://database/Assets/Icon/icon-shield.png"); }
.icon-device  { background-image: url("project://database/Assets/Icon/icon-user-add.png"); }
.icon-compass { background-image: url("project://database/Assets/Icon/material-symbols--search (1).png"); }
.icon-map     { background-image: url("project://database/Assets/Icon/Map Kampus PSDKU LAMONGAN.png"); }
.icon-star    { background-image: url("project://database/Assets/Icon/material-symbols--search (2).png"); }
.icon-wave    { background-image: url("project://database/Assets/Icon/mic.png"); }
.icon-send    { background-image: url("project://database/Assets/Icon/rivet-icons--user-group-solid.png"); }

/* ─── Decorative dots ─── */
.hero-dot {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(100, 160, 230);
    opacity: 0.5;
}
.dot-a { top: 28%; left: 30%; }
.dot-b { top: 50%; right: 18%; }

/* ─── Bottom Sheet (tightened) ─── */
.bottom-sheet {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 22px;
    padding-bottom: 6px;
    flex-direction: column;
}

/* ─── Logo Row ─── */
.logo-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background-color: rgb(26, 58, 143);
    background-image: url("project://database/Assets/UI/Images/Voice-Logo.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 10px;
}

.logo-text {
    font-size: 18px;
    color: rgb(26, 58, 143);
    -unity-font-style: bold;
}

/* ─── Headline ─── */
.headline {
    font-size: 28px;
    color: rgb(15, 23, 60);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

/* ─── Subtitle ─── */
.subtitle {
    font-size: 16px;
    color: rgb(107, 114, 128);
    white-space: normal;
    margin-bottom: 22px;
}

/* ─── Button Row (Lewati left, Mulai right) ─── */
.button-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.btn-skip {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: rgb(107, 114, 128);
    font-size: 17px;
    padding-left: 4px;
    padding-right: 4px;
}

.btn-skip:hover {
    color: rgb(26, 58, 143);
    background-color: rgba(0,0,0,0);
    border-width: 0;
}

.btn-start {
    background-color: rgb(26, 58, 143);
    border-width: 0;
    border-radius: 50px;
    color: rgb(255, 255, 255);
    font-size: 17px;
    -unity-font-style: bold;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 36px;
    padding-right: 36px;
}

.btn-start:hover {
    background-color: rgb(20, 46, 115);
    border-width: 0;
}

/* ─── Home Indicator (less space) ─── */
.home-indicator {
    width: 140px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(200, 205, 215);
    align-self: center;
    margin-top: 2px;
}
