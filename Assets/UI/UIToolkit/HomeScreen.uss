/* ══════════════════════════════════════════════
   Home Dashboard — MultiSetNav
   Reference: 1080 × 1920  (ScaleWithScreenSize)
   One layout, 3 role variants driven by controller:
     .role-mahasiswa · .role-dosen · .role-tamu  (on root)
   ══════════════════════════════════════════════ */

/* ─── Root ─── */
.home-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
}

/* ═══ Header ═══ */
.header {
    flex-direction: row;
    align-items: center;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 28px;
    padding-bottom: 20px;
    background-color: rgb(255, 255, 255);
}

.avatar {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: rgb(26, 58, 143);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 24px;
}
.avatar-initials {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
/* guest = soft gray avatar */
.role-tamu .avatar { background-color: rgb(203, 213, 225); }

.greeting-col { flex-direction: column; flex-grow: 1; }

.greeting-name {
    font-size: 38px;
    color: rgb(15, 23, 60);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.role-badge {
    align-self: flex-start;
    font-size: 22px;
    -unity-font-style: bold;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 20px;
    background-color: rgb(219, 234, 254);
    color: rgb(37, 99, 235);
}
.role-dosen .role-badge { background-color: rgb(220, 252, 231); color: rgb(22, 163, 74); }
.role-tamu  .role-badge { background-color: rgb(241, 243, 246); color: rgb(107, 114, 128); }

.bell-btn {
    width: 64px;
    height: 64px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/icon-bell.png");
}
.bell-btn:hover { background-color: rgba(0,0,0,0); border-width: 0; }

/* ═══ Search Bar ═══ */
.search-bar {
    flex-direction: row;
    align-items: center;
    height: 104px;
    margin-left: 40px;
    margin-right: 40px;
    margin-bottom: 12px;
    padding-left: 32px;
    padding-right: 20px;
    background-color: rgb(244, 247, 251);
    border-radius: 28px;
    border-width: 2px;
    border-color: rgb(228, 233, 240);
}
.search-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 20px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/material-symbols--search (1).png");
    -unity-background-image-tint-color: rgb(140, 150, 165);
}
.search-input { flex-grow: 1; background-color: rgba(0,0,0,0); margin: 0; }
.search-input .unity-base-text-field__input {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    font-size: 28px;
    color: rgb(40, 50, 70);
    padding: 0;
    -unity-text-align: middle-left;
}
.search-placeholder {
    font-size: 28px;
    color: rgb(160, 168, 180);
    flex-grow: 1;
}
.mic-btn {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/mic.png");
    -unity-background-image-tint-color: rgb(26, 58, 143);
}
.mic-btn:hover { background-color: rgba(0,0,0,0); border-width: 0; }

/* ═══ Guest Banner (tamu only) ═══ */
.guest-banner {
    display: none;
    flex-direction: row;
    align-items: center;
    margin-left: 40px;
    margin-right: 40px;
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 24px;
    background-color: rgb(219, 234, 254);
    border-radius: 22px;
}
.role-tamu .guest-banner { display: flex; }
.guest-banner-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 18px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/info.png");
    -unity-background-image-tint-color: rgb(37, 99, 235);
}
.guest-banner-text {
    flex-grow: 1;
    font-size: 24px;
    color: rgb(30, 58, 110);
    white-space: normal;
}
.guest-banner-link {
    flex-shrink: 0;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: rgb(37, 99, 235);
    font-size: 24px;
    -unity-font-style: bold;
    margin-left: 12px;
    padding: 4px;
}
.guest-banner-link:hover { background-color: rgba(0,0,0,0); border-width: 0; }

/* ═══ Scroll Content ═══ */
.scroll { flex-grow: 1; }
.scroll-content {
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 12px;
    padding-bottom: 40px;
}

/* ─── Section header ─── */
.section-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 28px;
    margin-bottom: 20px;
}
.section-title {
    font-size: 30px;
    color: rgb(15, 23, 60);
    -unity-font-style: bold;
}
.section-link {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: rgb(37, 99, 235);
    font-size: 24px;
    -unity-font-style: bold;
    padding: 4px;
}
.section-link:hover { background-color: rgba(0,0,0,0); border-width: 0; }

/* ═══ Quick Actions (2×2) ═══ */
.quick-grid { flex-direction: column; }
.quick-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 24px;
}
.quick-card {
    width: 48%;
    height: 180px;
    background-color: rgb(244, 248, 255);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgb(224, 233, 247);
    padding: 26px;
    justify-content: space-between;
}
.quick-card:hover { background-color: rgb(235, 242, 255); border-color: rgb(200, 216, 244); }
.quick-icon {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(26, 58, 143);
}
.quick-label {
    font-size: 26px;
    color: rgb(30, 41, 71);
    -unity-font-style: bold;
}
/* locked card (tamu) */
.quick-card.locked { background-color: rgb(247, 248, 250); border-color: rgb(232, 235, 240); }
.quick-card.locked .quick-icon { -unity-background-image-tint-color: rgb(176, 184, 196); }
.quick-card.locked .quick-label { color: rgb(176, 184, 196); }
.lock-badge {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 34px;
    height: 34px;
    display: none;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/icon-lock.png");
    -unity-background-image-tint-color: rgb(176, 184, 196);
}
.quick-card.locked .lock-badge { display: flex; }

.icon-ar       { background-image: url("project://database/Assets/Icon/icon-navigation.png"); }
.icon-room     { background-image: url("project://database/Assets/Icon/icon-building.png"); }
.icon-calendar { background-image: url("project://database/Assets/Icon/icon-calendar.png"); }
.icon-star     { background-image: url("project://database/Assets/Icon/icon-star.png"); }
.icon-room2    { background-image: url("project://database/Assets/Icon/icon-building2.png"); }

/* ═══ Destinasi Populer (horizontal 3) ═══ */
.dest-row { flex-direction: row; justify-content: space-between; }
.dest-card { width: 31%; flex-direction: column; }
.dest-thumb {
    height: 150px;
    border-radius: 18px;
    background-color: rgb(222, 235, 252);
    margin-bottom: 14px;
}
.dest-name {
    font-size: 24px;
    color: rgb(20, 30, 55);
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}
.dest-sub {
    font-size: 20px;
    color: rgb(120, 130, 145);
    margin-bottom: 10px;
}
.dest-pill {
    align-self: flex-start;
    font-size: 19px;
    color: rgb(37, 99, 235);
    background-color: rgb(225, 236, 254);
    border-radius: 14px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* ═══ Riwayat Navigasi ═══ */
.history-list { flex-direction: column; }
.history-item {
    flex-direction: row;
    align-items: center;
    background-color: rgb(248, 250, 252);
    border-radius: 20px;
    padding: 22px;
    margin-bottom: 18px;
}
.history-item:hover { background-color: rgb(241, 245, 250); }
.history-icon {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    background-color: rgb(225, 236, 254);
    flex-shrink: 0;
    margin-right: 24px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/icon-send-plane.png");
    -unity-background-image-tint-color: rgb(26, 58, 143);
}
.history-texts { flex-direction: column; flex-grow: 1; }
.history-title {
    font-size: 26px;
    color: rgb(20, 30, 55);
    -unity-font-style: bold;
    margin-bottom: 4px;
}
.history-time { font-size: 22px; color: rgb(140, 150, 165); }
.history-chevron {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    rotate: 180deg;
    background-image: url("project://database/Assets/Icon/weui--back-filled.png");
    -unity-background-image-tint-color: rgb(180, 188, 200);
}

/* empty history (tamu) */
.history-empty {
    display: none;
    flex-direction: column;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 40px;
}
.role-tamu .history-list  { display: none; }
.role-tamu .history-empty { display: flex; }
.empty-icon {
    width: 70px;
    height: 70px;
    margin-bottom: 20px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/icon-history.png");
    -unity-background-image-tint-color: rgb(190, 198, 210);
}
.empty-title {
    font-size: 26px;
    color: rgb(120, 130, 145);
    -unity-font-style: bold;
    margin-bottom: 8px;
}
.empty-sub {
    font-size: 22px;
    color: rgb(160, 168, 180);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ═══ Bottom Nav ═══ */
.bottom-nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 150px;
    padding-left: 30px;
    padding-right: 30px;
    background-color: rgb(255, 255, 255);
    border-top-width: 2px;
    border-top-color: rgb(236, 239, 244);
}
.nav-item {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    width: 150px;
}
.nav-item:hover { background-color: rgba(0,0,0,0); border-width: 0; }
.nav-icon {
    width: 46px;
    height: 46px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(150, 158, 170);
}
.nav-label { font-size: 20px; color: rgb(150, 158, 170); }
.nav-item.active .nav-icon  { -unity-background-image-tint-color: rgb(26, 58, 143); }
.nav-item.active .nav-label { color: rgb(26, 58, 143); -unity-font-style: bold; }

.icon-home    { background-image: url("project://database/Assets/Icon/icon-home.png"); }
.icon-map     { background-image: url("project://database/Assets/Icon/icon-map.png"); }
.icon-history { background-image: url("project://database/Assets/Icon/icon-history.png"); }
.icon-profile { background-image: url("project://database/Assets/Icon/icon-profile.png"); }

/* center FAB */
.fab {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(37, 99, 235);
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Icon/icon-photo-capture.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.fab:hover { background-color: rgb(29, 78, 216); border-width: 0; }
/* dim FAB for guest */
.role-tamu .fab { background-color: rgb(147, 180, 230); }
.role-tamu .nav-history,
.role-tamu .nav-profile { opacity: 0.45; }
